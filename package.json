{
  "name": "mypage",
  "version": "1.0.0",
  "description": "Personal homepage with a passkey-protected private area (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mypage --local",
    "db:migrate:remote": "wrangler d1 migrations apply mypage --remote",
    "test": "node scripts/e2e-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoisinsu/mypage.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/whoisinsu/mypage/issues"
  },
  "homepage": "https://github.com/whoisinsu/mypage#readme",
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  },
  "private": true
}
